@page "/p/{code}/admin"
@model Shoebox.Web.Pages.Pool.AdminModel
@{
    ViewData["Title"] = $"Manage · {Model.Pool.Name}";
}

@section HeaderActions {
    <div class="header-actions">
        <a class="btn btn-ghost" href="/p/@Model.Pool.Code">← Back to gallery</a>
    </div>
}

<div class="narrow">
    <h1>Manage “@Model.Pool.Name”</h1>

    @if (Model.JustCreated)
    {
        <div class="banner success">
            Your box is ready! <strong>Bookmark this admin link.</strong> It's the only way to manage the box:
            <input type="text" readonly value="@Model.AdminUrl" class="admin-link" onclick="this.select()" />
            <a class="btn btn-primary banner-cta" href="/p/@Model.Pool.Code">Open the gallery &rarr;</a>
        </div>
    }

    <section class="card">
        <h2>Share</h2>
        <div class="share-grid">
            <div>
                <p>Send the link, or put the QR code where everyone will see it:
                   on the table, by the door, taped to the cooler.</p>
                <div class="share-link-row">
                    <input type="text" readonly value="@Model.ShareUrl" onclick="this.select()" />
                </div>
                <p class="pool-meta">Or join by code: <strong class="code">@Model.Pool.Code</strong></p>
            </div>
            <img src="/api/p/@Model.Pool.Code/qr" alt="QR code for pool link" class="qr" />
        </div>
    </section>

    <section class="card form-stack">
        <h2>Settings</h2>
        <form method="post" asp-page-handler="Update">
            <label>
                Box name
                <input type="text" name="name" maxlength="120" required value="@Model.Pool.Name" />
            </label>
            <label>
                Description
                <textarea name="description" maxlength="2000" rows="2">@Model.Pool.Description</textarea>
            </label>
            <label>
                Automatically delete
                <select name="expiryDays">
                    @foreach (var (days, text) in Model.ExpiryChoices)
                    {
                        <option value="@days" selected="@(days == Model.SelectedExpiryDays)">@text</option>
                    }
                </select>
            </label>
            @if (Model.Pool.ExpiresAt is { } exp)
            {
                <p class="muted">Currently set to clear out on @exp.ToString("d MMM yyyy").</p>
            }
            <label class="checkbox">
                <input type="checkbox" name="changePassword" value="true" /> Change password
            </label>
            <label>
                New password <span class="muted">(leave empty to remove the password)</span>
                <input type="password" name="newPassword" maxlength="200" autocomplete="new-password" />
            </label>
            <button type="submit" class="btn btn-primary">Save changes</button>
        </form>
        @if (Model.Saved)
        {
            <p class="success-text">Saved.</p>
        }
    </section>

    <section class="card danger-zone">
        <h2>Danger zone</h2>
        <p>This deletes the box and every photo in it, permanently.</p>
        <form method="post" asp-page-handler="Delete"
              onsubmit="return confirm('Delete this box and ALL its photos? This cannot be undone.');">
            <button type="submit" class="btn btn-danger">Delete box</button>
        </form>
    </section>
</div>
