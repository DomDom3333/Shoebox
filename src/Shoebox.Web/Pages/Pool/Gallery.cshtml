@page "/p/{code}"
@model Shoebox.Web.Pages.Pool.GalleryModel
@{
    ViewData["Title"] = Model.Pool.Name;
}

@section HeaderActions {
    <div class="header-actions">
        @if (Model.IsAdmin)
        {
            <a class="btn btn-ghost" href="/p/@Model.Pool.Code/admin">Manage</a>
        }
        <button type="button" class="btn btn-ghost" id="share-btn">Share</button>
    </div>
}

<div class="pool-head">
    <h1>@Model.Pool.Name</h1>
    @if (!string.IsNullOrEmpty(Model.Pool.Description))
    {
        <p class="pool-desc">@Model.Pool.Description</p>
    }
    <p class="pool-meta">
        Box code: <strong class="code">@Model.Pool.Code</strong>
        · @Model.Photos.Count photo@(Model.Photos.Count == 1 ? "" : "s")
        @if (Model.Uploaders.Count > 0)
        {
            <text>· from @Model.Uploaders.Count @(Model.Uploaders.Count == 1 ? "person" : "people")</text>
        }
    </p>
    @if (Model.ExpiresSoon)
    {
        <p class="banner warn">This box clears out on @(Model.Pool.ExpiresAt?.ToString("d MMM yyyy")). Grab what you want to keep.</p>
    }
</div>

<section class="card upload-card" id="upload-card">
    <div class="upload-row">
        <label class="uploader-name-label">
            Uploading as
            <input type="text" id="uploader-name" maxlength="80" placeholder="Your name"
                   value="@Model.UploaderName" />
        </label>
        <div class="upload-actions">
            <button type="button" class="btn btn-primary" id="pick-files">Add photos</button>
            <input type="file" id="file-input" accept="image/*,.heic,.heif" multiple hidden />
        </div>
    </div>
    <p class="dropzone" id="dropzone">or drop photos anywhere on this page</p>
    <ul class="upload-progress" id="upload-progress"></ul>
</section>

<p class="storage-note">
    This is a shared box for photos, not a safe place to keep them. Photos here aren't locked, a
    box can be set to empty itself, and there's no spare copy. Save any you want to keep.
</p>

<section class="gallery-tools">
    <label class="filter">
        Show:
        <select id="uploader-filter">
            <option value="">Everyone (@Model.Photos.Count)</option>
            @foreach (var uploader in Model.Uploaders)
            {
                <option value="@uploader.Name">@uploader.Name (@uploader.Count)</option>
            }
        </select>
    </label>
    <div class="download-buttons">
        @if (Model.Photos.Count > 0)
        {
            <a class="btn btn-ghost" href="/api/p/@Model.Pool.Code/zip?mode=all">Download all photos</a>
            @* Phone-only: revealed by gallery.js on touch devices whose browser can
               hand image files to the OS share sheet (mobile Safari / Chrome). *@
            <button type="button" class="btn btn-ghost" id="save-gallery-btn" hidden>Save to gallery</button>
        }
        else
        {
            <span class="btn btn-ghost" aria-disabled="true">Download all photos</span>
        }
        @if (Model.HasOthers)
        {
            <a class="btn btn-ghost" href="/api/p/@Model.Pool.Code/zip?mode=others"
               title="Downloads every photo added by other people — everything except your own uploads">Download everyone else's</a>
        }
        else
        {
            <span class="btn btn-ghost" aria-disabled="true"
                  title="Nothing to download yet — no one else has added photos">Download everyone else's</span>
        }
    </div>
</section>

@if (Model.Photos.Count == 0)
{
    <div class="empty-state">
        <p><span class="big">Nothing here yet.</span> You were there. Prove it.</p>
    </div>
}

<div class="gallery" id="gallery">
    @for (var i = 0; i < Model.Photos.Count; i++)
    {
        var photo = Model.Photos[i];
        <figure class="tile @(photo.Mine ? "mine" : "")" style="--i: @Math.Min(i, 12)"
                data-id="@photo.Id" data-uploader="@photo.UploaderName"
                data-original="/api/photos/@photo.Id/original" data-filename="@photo.FileName">
            @if (photo.HasThumbnail)
            {
                <img src="/api/photos/@photo.Id/thumb" loading="lazy" alt="@photo.FileName" />
            }
            else
            {
                <div class="no-thumb" title="Preview not available for this file"><span>@photo.FileName</span></div>
            }
            <figcaption>
                <span class="uploader">@photo.UploaderName</span>
                @if (photo.Mine)
                {
                    <span class="badge-you">you</span>
                }
                @if (photo.Mine || Model.IsAdmin)
                {
                    <button type="button" class="delete-btn" title="Delete photo">&times;</button>
                }
            </figcaption>
        </figure>
    }
</div>

<div class="lightbox" id="lightbox" hidden>
    <button type="button" class="lb-close" title="Close">&times;</button>
    <button type="button" class="lb-prev" title="Previous">&larr;</button>
    <img id="lightbox-img" alt="" />
    <button type="button" class="lb-next" title="Next">&rarr;</button>
    <div class="lb-bar">
        <span id="lightbox-caption"></span>
        <a id="lightbox-download" class="btn btn-ghost" download>Download</a>
    </div>
</div>

<dialog id="share-dialog" class="share-dialog">
    <h2>Share this box</h2>
    <p>Anyone with the link can join@(Model.Pool.HasPassword ? " (they'll need the password)" : "").</p>
    <img src="/api/p/@Model.Pool.Code/qr" alt="QR code for pool link" class="qr" />
    <div class="share-link-row">
        <input type="text" readonly id="share-url" value="@Model.ShareUrl" />
        <button type="button" class="btn btn-primary" id="copy-link">Copy</button>
    </div>
    <button type="button" class="btn btn-ghost" id="share-close">Close</button>
</dialog>

@section Scripts {
    <script src="~/js/gallery.js" asp-append-version="true"></script>
}
