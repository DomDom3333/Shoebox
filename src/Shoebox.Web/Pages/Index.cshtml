@page
@model IndexModel
@{
    ViewData["Title"] = "";
}

<div class="hero">
    <h1>Your friends took the best photos <em class="underline">of you</em>.</h1>
    <p class="lead">
        Every family has one: a shoebox in the closet where the loose prints pile up. No labels,
        no order, just the good stuff from every trip and party. Shoebox is that box for your
        event, and it fills itself while everyone's together. The night ends; the box keeps it
        going a little longer.
    </p>
</div>

@if (Model.MyBoxes.Count > 0)
{
    <section class="my-boxes">
        <h2>Your boxes</h2>
        <p class="lead">Boxes this device has opened or created. Only this browser sees this list; it comes from your cookies, not an account.</p>
        <ul class="box-list">
            @foreach (var box in Model.MyBoxes)
            {
                <li class="box-row">
                    <a asp-page="/Pool/Gallery" asp-route-code="@box.Code" class="box-link">
                        <span class="box-name">@box.Name</span>
                        <span class="box-meta">
                            <span class="box-code">@box.Code</span>
                            <span class="box-count">@box.PhotoCount photo@(box.PhotoCount == 1 ? "" : "s")</span>
                            @if (box.IsAdmin)
                            {
                                <span class="box-tag">admin</span>
                            }
                        </span>
                    </a>
                    @if (box.IsAdmin)
                    {
                        <a asp-page="/Pool/Admin" asp-route-code="@box.Code" class="btn btn-ghost box-admin-btn">Admin panel</a>
                    }
                </li>
            }
        </ul>
    </section>
}

<div class="home-grid">
    <section>
        <h2>Start a box</h2>
        <p class="lead">Name it, share the link or QR code, and the photos start arriving.</p>
        <a href="/Create" class="btn btn-primary">Create a box</a>
    </section>

    <section>
        <h2>Join with a code</h2>
        <p class="lead">Someone handed you an eight-letter code? In you go.</p>
        <form method="post" asp-page-handler="Join" class="join-form">
            <input type="text" name="code" placeholder="K7MPX2WQ" autocomplete="off"
                   autocapitalize="characters" spellcheck="false" maxlength="16" required
                   value="@Model.Code" class="code-input" aria-label="Pool code" />
            <button type="submit" class="btn btn-ghost">Open box</button>
        </form>
        @if (Model.CodeNotFound)
        {
            <p class="error">No box with that code. Double-check it and try again.</p>
        }
    </section>

    <section>
        <h2>How it works</h2>
        <ol class="steps">
            <li><span><strong>Create.</strong> One box per event. Password and auto-delete optional.</span></li>
            <li><span><strong>Share.</strong> Put the QR code on the table; guests upload under their name.</span></li>
            <li><span><strong>Collect.</strong> Browse the gallery, then download everyone else's photos as a ZIP.</span></li>
        </ol>
    </section>
</div>
